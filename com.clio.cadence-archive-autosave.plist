<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clio.cadence-archive-autosave</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/run_archive_autosave.sh</string>
  </array>

  <!-- Fire every Friday at 2:00 PM — three hours before com.clio.cadence-scorer's
       5:00 PM run, so whatever gets confirmed here is baked into that run's
       regenerated index.html and captured by its own git add. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>5</integer>
    <key>Hour</key><integer>14</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/archive_autosave.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/archive_autosave.launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
