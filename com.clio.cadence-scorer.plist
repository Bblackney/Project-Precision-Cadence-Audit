<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clio.cadence-scorer</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/run_weekly.sh</string>
  </array>

  <!-- Fire every Friday at 5:00 PM. Weekday: 0/7=Sun, 1=Mon … 5=Fri -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>5</integer>
    <key>Hour</key><integer>17</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- If the Mac is asleep at 5pm Fri, launchd runs the missed job on wake. -->
  <key>StandardOutPath</key>
  <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brettblackney/Documents/Claude/Project Precision/Cadence Performance Scorecard — Weekly Scoring/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
